# ============================================================
# sso.pdhc — Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
# Format: postgresql://user:password@host:port/dbname
DB_PASSWORD=change-me-in-production
# +psycopg2 is EXPLICIT and load-bearing (#711, #930). This file is what
# the operator copies to make the real .env on a fresh deploy (Rule 23),
# so a bare `postgresql://` here reaches production by hand even when the
# compose is correct. SQLAlchemy 2.1 resolves a bare scheme to psycopg v3,
# which no PDHC service installs.
DATABASE_URL=postgresql+psycopg2://sso_user:change-me-in-production@localhost:9003/sso_db

# --- JWT ---
SESSION_EXPIRY_HOURS=24

# --- Bootstrap Superuser (first deployment only) ---
BOOTSTRAP_SU_EMAIL=admin@example.com
BOOTSTRAP_SU_PASSWORD=change-me-minimum-8-chars

# --- SSO Handshake ---
# Comma-separated origins allowed for CORS and SSO redirect
ALLOWED_ORIGINS=http://localhost:9000
# Comma-separated exact callback URLs for SSO handshake redirect
ALLOWED_CALLBACK_URLS=http://localhost:9000/callback

# --- Service Credentials (one pair per downstream service) ---
# SSO_CLIENT_ID_SERVICENAME=client-id-here
# SSO_CLIENT_SECRET_SERVICENAME=client-secret-here

# --- API Key Metadata ---
KEY_CREATED_AT=2026-03-18T00:00:00Z

# --- Logging ---
LOG_DIR=./logs

# --- Patient second factor (#1040) ---
# Passkeys (WebAuthn) are bound to ONE site. Both must be set or passkeys are
# refused by name (`passkey_not_configured`) and only TOTP works. Production:
#   WEBAUTHN_RP_ID=sso.pdhc.se     WEBAUTHN_ORIGIN=https://sso.pdhc.se
# Changing WEBAUTHN_RP_ID later orphans every passkey already registered.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:9000
WEBAUTHN_RP_NAME=PDHC
# Where the "go to the patient app" link points. Empty hides the link.
# Production: https://patientapp.pdhc.se
PATIENTAPP_URL=
# TOTP secrets, patient-invite tokens and link codes are protected with keys
# DERIVED from SECRET_KEY (no extra variable). Rotating SECRET_KEY therefore
# forces TOTP users to enrol again and voids outstanding invites and codes.

# --- eps check on patient links (#1040) ---
# Before a patient link is written, SSO asks eps.pdhc whether the patient guid
# exists and the patient is listed at the care unit. Both must be set or
# linking refuses with `eps_not_configured`. There is no default URL.
# Production: EPS_BASE_URL=https://eps.pdhc.se, EPS_API_KEY=<a key minted in
# eps for sso; sent as "Authorization: ApiKey <key>">.
EPS_BASE_URL=
EPS_API_KEY=
# LOCAL DEVELOPMENT ONLY: skip the eps check. The app refuses to start with
# this set unless FLASK_ENV=development.
# EPS_LINK_CHECK_DISABLED=true
